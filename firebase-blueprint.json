{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "tiktokId": {
          "type": "string",
          "description": "The user's TikTok ID"
        },
        "balance": {
          "type": "number",
          "description": "Current coin balance"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the user profile was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the user profile was last updated"
        }
      },
      "required": ["tiktokId", "balance", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Coin purchase history",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user who made the purchase"
        },
        "coins": {
          "type": "number",
          "description": "Number of coins purchased"
        },
        "price": {
          "type": "number",
          "description": "Total price paid in VND"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "completed", "failed"],
          "description": "Status of the transaction"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the transaction occurred"
        }
      },
      "required": ["userId", "coins", "price", "status", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles"
    },
    "transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Collection of coin purchase transactions"
    }
  }
}
